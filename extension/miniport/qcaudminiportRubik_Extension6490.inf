; Rubik Pi 3 extension for Qualcomm's Kodiak Q6A audio miniport (qcaudminiport6490).
;
; Rubik Pi 3:
;   * Speaker = ES8316 3.5 mm jack on PRIMARY MI2S.
;   * ExternalDisplay = LT9611 HDMI endpoint, published when OEMBridge registers
;     the sink with the miniport.
;   * SpeakerHeadset and MicArray1 are disabled; MicIn is the ES8316 capture
;     endpoint. Bluetooth endpoint defaults remain as listed in AddReg.
;   * UseInternalCodec=0 on the board endpoints: there is no WCD/WSA codec.
;
; QCRT currently inherits SUBSYS_IOT06490. Qualcomm's IOT miniport extension
; has a different ExtensionId and can therefore apply alongside this one;
; remove the overlapping donor extension during Rubik installation.
;

[Version]
Signature="$CHICAGO$"
Class=Extension
ClassGUID={e2f84ce7-8efa-411c-aa69-97454ca4cb57}
provider=%QCOM%
ExtensionId={656CA7C6-A0D8-4640-8A87-C681C3690AED}
DriverVer = 11/09/2026,1.0.4444.9382
CatalogFile=qcaudminiportRubik_Extension6490.cat
PnpLockdown=1

[Manufacturer]
%MfgName%=Extension_Device,NTARM64

[Extension_Device.NTARM64]
%DeviceDesc%=Extension_Device_IOT_Inst, AUCD\VEN_QCOM&DEV_0E29&SUBSYS_RUBI6490
%DeviceDescInherited%=Extension_Device_IOT_Inst, AUCD\VEN_QCOM&DEV_0E29&SUBSYS_IOT06490

[Extension_Device_IOT_Inst.HW]
AddReg=AUDIOHW_AddReg

